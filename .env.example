DATABASE_URL=postgres://user:password@localhost:5432/attorney_directory
PGSSL=off
PORT=3000

# Credentials required to access /admin (HTTP Basic Auth)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Required for user/attorney sessions to work at all — the app refuses to start without this
SESSION_SECRET=change-me-to-a-long-random-string

# Stripe (pay-per-question and contract purchases). Get these from the Stripe dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Cloudflare Turnstile (anti-spam on registration, lead forms, case verification).
# For local dev, Cloudflare's documented always-pass test keys work without a real account:
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare R2 (S3-compatible) — stores contract files and case-verification ID uploads privately
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
