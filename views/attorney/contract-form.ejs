<%- include('../partials/head') %>

<p><a href="/attorney/dashboard">&larr; Back to dashboard</a></p>

<div class="hero">
  <h1>My contract</h1>
  <div class="rule"></div>
  <p class="lead">List one signature contract template for sale. It appears both on your profile and on the shared Contracts for Sale page.</p>
</div>

<div class="search-panel">
  <% if (error) { %><p class="muted" style="color:var(--danger)"><%= error %></p><% } %>

  <form method="post" action="/attorney/contract" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <label for="title">Title</label>
    <input type="text" id="title" name="title" value="<%= contract.title %>" required>

    <label for="description">Description</label>
    <textarea id="description" name="description" rows="4"><%= contract.description %></textarea>

    <label for="price_dollars">Price ($)</label>
    <input type="number" id="price_dollars" name="price_dollars" min="0" step="0.01"
           value="<%= ((contract.price_cents || 0) / 100).toFixed(2) %>" required>

    <label for="file">Contract file (PDF, first upload required<%= contract.file_name ? '; currently: ' + contract.file_name : '' %>)</label>
    <input type="file" id="file" name="file" accept="application/pdf,image/jpeg,image/png">

    <p>
      <label style="display:inline-flex;align-items:center;gap:.5rem;width:auto;margin:0">
        <input type="checkbox" name="active" value="1" <%= contract.active ? 'checked' : '' %> style="width:auto;accent-color:var(--gold)">
        Active (visible for sale)
      </label>
    </p>

    <p><button class="btn" type="submit">Save contract</button></p>
  </form>
</div>

<%- include('../partials/foot') %>
