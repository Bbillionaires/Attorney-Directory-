<%- include('partials/head') %>

<div class="hero">
  <h1>Log in</h1>
  <div class="rule"></div>
</div>

<div class="search-panel">
  <% if (error) { %><p class="muted" style="color:var(--danger)"><%= error %></p><% } %>

  <form method="post" action="/login">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <label for="email">Email</label>
    <input type="email" id="email" name="email" value="<%= form.email || '' %>" required>

    <label for="password">Password</label>
    <input type="password" id="password" name="password" required>

    <p style="margin-top:1rem"><button class="btn" type="submit">Log in</button></p>
  </form>

  <p class="small muted">Don't have an account? <a href="/register">Register</a>.</p>
</div>

<%- include('partials/foot') %>
