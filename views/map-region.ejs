<%- include('partials/head') %>

<p><a href="/map">&larr; Back to map</a></p>

<div class="hero">
  <h1>Attorneys in <%= regionName %></h1>
  <div class="rule"></div>
  <p class="lead"><%= total %> listing<%= total === 1 ? '' : 's' %>, grouped by city and practice area.</p>
</div>

<% if (!cities.length) { %>
  <div class="empty">No attorneys listed in <%= regionName %> yet. <a href="/directory">Browse the full directory</a> instead.</div>
<% } else { %>
  <% cities.forEach(function (c) { %>
    <div class="section" style="margin:2.2rem 0">
      <h2><%= c.city %></h2>
      <% c.categories.forEach(function (cat) { %>
        <h3 class="small" style="color:var(--gold-dim);text-transform:uppercase;letter-spacing:1px;margin:1.1rem 0 .6rem"><%= cat.category %></h3>
        <div class="list">
          <% cat.firms.forEach(function (l) { %>
            <div class="card">
              <% if (l.is_verified) { %><span class="badge">Verified</span><% } %>
              <% if (!l.user_id) { %><span class="badge">Partner Firm</span><% } %>
              <h3><a href="/listing/<%= l.id %>"><%= l.name %></a></h3>
              <p class="small muted"><%= l.description %></p>
            </div>
          <% }) %>
        </div>
      <% }) %>
    </div>
  <% }) %>
<% } %>

<p style="margin-top:1.6rem"><a class="btn secondary" href="/map">Back to Map</a></p>

<%- include('partials/foot') %>
