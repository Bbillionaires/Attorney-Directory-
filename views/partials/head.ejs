<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title + ' — Attorney Menu' : 'Attorney Menu' %></title>
  <meta name="description" content="Attorney Menu — the only attorney directory you need to get served.">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>⚖️</text></svg>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css?v=<%= typeof buildId !== 'undefined' ? buildId : 0 %>">
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
</head>
<body>
  <%- include('scale-bg') %>
  <header>
    <nav class="nav">
      <a class="brand" href="/"><span class="mark">⚖</span> <span class="gold-shine">Attorney Menu</span></a>
      <input type="checkbox" id="nav-toggle" class="nav-toggle-input">
      <label for="nav-toggle" class="nav-toggle" aria-label="Menu">&#9776;</label>
      <div class="nav-links">
        <a href="/directory">Attorney Directory</a>
        <a href="/map">World Map</a>
        <a href="/contracts">Contracts for Sale</a>
        <a href="/litigation-support">Litigation Support</a>
        <a href="/settlement-loan">Settlement Loans</a>
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <% if (currentUser.role === 'attorney') { %>
            <a href="/attorney/dashboard">Dashboard</a>
          <% } else { %>
            <a href="/my/purchases">My Purchases</a>
          <% } %>
          <a href="/account">My Account</a>
          <form action="/logout" method="post">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <button type="submit" class="nav-logout">Log out</button>
          </form>
        <% } else { %>
          <a href="/login">Log in</a>
          <a href="/register">Register</a>
        <% } %>
      </div>
    </nav>
  </header>
  <main class="container menu-frame">
    <span class="edge edge-top" aria-hidden="true"></span>
    <span class="edge edge-bottom" aria-hidden="true"></span>
    <span class="edge edge-left" aria-hidden="true"></span>
    <span class="edge edge-right" aria-hidden="true"></span>
    <span class="corner corner-tl" aria-hidden="true"><%- include('corner-flourish') %></span>
    <span class="corner corner-tr" aria-hidden="true"><%- include('corner-flourish') %></span>
    <span class="corner corner-bl" aria-hidden="true"><%- include('corner-flourish') %></span>
    <span class="corner corner-br" aria-hidden="true"><%- include('corner-flourish') %></span>
